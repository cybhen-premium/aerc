# Neon PostgreSQL Database Connection String
DATABASE_URL="postgresql://username:password@ep-host.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication Session Secret (Generate a 32+ character random secret)
ADMIN_SESSION_SECRET="super-secret-random-key-change-this-for-production"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
